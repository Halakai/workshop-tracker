# Copy to .env.local (git-ignored) and fill in. Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The PUBLISHABLE key (sb_publishable_…). It is meant to be public: Row Level Security protects the data.
# Never put the secret key (sb_secret_…) here or anywhere in the frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only for the Supabase CLI on your computer (`npm run db:push`). Never committed, never in the app.
SUPABASE_DB_PASSWORD=
